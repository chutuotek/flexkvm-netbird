+//go:build !android
+
+package firewall
+
+import (
+	"net/netip"
+
+	log "github.com/sirupsen/logrus"
+
+	firewall "github.com/netbirdio/netbird/client/firewall/manager"
+	"github.com/netbirdio/netbird/client/internal/statemanager"
+)
+
+// nopManager 是"什么都不装"的 firewall.Manager。
+//
+// IP-KVM 裁剪：iptables/nftables 后端与用户态包过滤（uspfilter）都不再编译进来，
+// 因此客户端没有本地 ACL 引擎。路由、网卡与连通性不受影响，丢掉的只是
+// 本地安装的 filter/NAT 规则——即管理端下发的访问策略不会在本机强制执行。
+type nopManager struct{}
+
+var _ firewall.Manager = nopManager{}
+
+func (nopManager) Init(*statemanager.Manager) error { return nil }
+
+func (nopManager) AddFilterRule([]byte, []netip.Prefix, firewall.Network, firewall.Protocol, *firewall.Port, *firewall.Port, firewall.Action) (firewall.Rule, error) {
+	return nil, nil
+}
+
+func (nopManager) DeleteFilterRule(firewall.Rule) error    { return nil }
+func (nopManager) IsServerRouteSupported() bool            { return false }
+func (nopManager) IsStateful() bool                        { return false }
+func (nopManager) AddNatRule(firewall.RouterPair) error    { return nil }
+func (nopManager) RemoveNatRule(firewall.RouterPair) error { return nil }
+func (nopManager) SetLegacyManagement(bool) error          { return nil }
+func (nopManager) Close(*statemanager.Manager) error       { return nil }
+func (nopManager) Flush() error                            { return nil }
+func (nopManager) SetLogLevel(log.Level)                   {}
+func (nopManager) EnableRouting() error                    { return nil }
+func (nopManager) DisableRouting() error                   { return nil }
+func (nopManager) UpdateSet(firewall.Set, []netip.Prefix) error { return nil }
+
+func (nopManager) AddInboundDNAT(netip.Addr, firewall.Protocol, uint16, uint16) error { return nil }
+
+func (nopManager) RemoveInboundDNAT(netip.Addr, firewall.Protocol, uint16, uint16) error {
+	return nil
+}
+
+func (nopManager) AddOutputDNAT(netip.Addr, firewall.Protocol, uint16, uint16) error { return nil }
+
+func (nopManager) RemoveOutputDNAT(netip.Addr, firewall.Protocol, uint16, uint16) error {
+	return nil
+}
